<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="mountain_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://mountain_terrain/materials/textures/heightmap.png</uri>
            <size>100.0 100.0 15.0</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.9</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
            <torsional>
              <coefficient>1.0</coefficient>
              <patch_radius>0.05</patch_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1000000.0</kp>
              <kd>100.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.003</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <heightmap>
            <use_terrain_paging>false</use_terrain_paging>
            <texture>
              <diffuse>model://mountain_terrain/materials/textures/dirt_diffuse.png</diffuse>
              <normal>model://mountain_terrain/materials/textures/flat_normal.png</normal>
              <size>5.0</size>
            </texture>
            <texture>
              <diffuse>model://mountain_terrain/materials/textures/grass_diffuse.png</diffuse>
              <normal>model://mountain_terrain/materials/textures/flat_normal.png</normal>
              <size>5.0</size>
            </texture>
            <texture>
              <diffuse>model://mountain_terrain/materials/textures/rock_diffuse.png</diffuse>
              <normal>model://mountain_terrain/materials/textures/flat_normal.png</normal>
              <size>10.0</size>
            </texture>
            <blend>
              <min_height>1.5</min_height>
              <fade_dist>2.0</fade_dist>
            </blend>
            <blend>
              <min_height>7.0</min_height>
              <fade_dist>3.0</fade_dist>
            </blend>
            <uri>model://mountain_terrain/materials/textures/heightmap.png</uri>
            <size>100.0 100.0 15.0</size>
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
